# ---------------------------------------------------------------------------
# CivicPulse AI frontend configuration
# Copy to frontend/.env.local. Both values are OPTIONAL.
# Without VITE_API_URL the app runs fully in demo mode (local AI heuristic,
# localStorage reports) — perfect for a hackathon demo with no keys.
# ---------------------------------------------------------------------------

# FastAPI backend base URL. Set this to enable real Gemini analysis + chat.
# VITE_API_URL=http://localhost:8000

# Supabase (only needed if you wire Supabase Auth/Storage instead of demo auth)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# NOTE: never put a Gemini / service-role key in a VITE_ variable.
# Anything prefixed with VITE_ is shipped to the browser.
