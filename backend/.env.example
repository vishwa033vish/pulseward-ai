# ---------------------------------------------------------------------------
# PulseWard AI backend configuration
# Copy to backend/.env and fill in what you have. Everything is optional:
# without a Gemini key the API returns 503 and the frontend falls back to its
# local demo analyzer. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Gemini (Google AI Studio) — server-side only, never exposed to the browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated browser origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (optional; used when you move from in-memory demo storage to Postgres)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
ENVIRONMENT=development
MAX_IMAGE_MB=6
